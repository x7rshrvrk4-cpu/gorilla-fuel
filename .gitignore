# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# OFF data dumps (multi-GB, never commit)
/data/
*.jsonl.gz

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code local session/config — ignore all local state EXCEPT the
# version-controlled native hook config (settings.json + hooks/). Uses
# `.claude/*` (not `.claude/`) so git descends into the dir; a fully-excluded
# dir cannot have its children re-included.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/hooks/pretooluse-guard.mjs

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*
